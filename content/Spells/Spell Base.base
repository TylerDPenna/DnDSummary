views:
  - type: table
    name: Table
    filters:
      and:
        - file.inFolder("Root/content/Spells/Spell List")
    order:
      - file.name
      - file.links
      - file.tags
    sort:
      - property: file.name
        direction: DESC
      - property: file.tags
        direction: ASC
    columnSize:
      file.links: 462
